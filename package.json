{
  "name": "brit-mashiach",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "seed:aliyot": "tsx --env-file=.env.local scripts/seed-aliyot.ts",
    "sync:pdfs": "tsx --env-file=.env.local scripts/sync-aliyot-pdfs.ts",
    "sync:pardes": "tsx --env-file=.env.local scripts/sync-parasha-pardes.ts",
    "sync:aliyot": "tsx --env-file=.env.local scripts/sync-aliyot-content.ts",
    "sync:aliyah1": "tsx --env-file=.env.local scripts/sync-aliyah1-content.ts",
    "sync:seo": "npm run sync:pardes && npm run sync:aliyot",
    "sync:manhigut": "tsx --env-file=.env.local scripts/sync-manhigut-modules.ts",
    "check:sitemap": "tsx --env-file=.env.local scripts/check-sitemap.ts",
    "check:tanach-audio": "tsx scripts/validate-mechon-coverage.ts",
    "check:auth": "tsx --env-file=.env.local scripts/check-auth-config.ts",
    "auth:recovery": "tsx --env-file=.env.local scripts/send-password-recovery.ts",
    "check:asaas-migration": "tsx --env-file=.env.local scripts/check-asaas-migration.mjs",
    "apply:asaas-migration": "tsx --env-file=.env.local scripts/apply-asaas-migration.mjs",
    "populate": "npm run seed:aliyot && npm run sync:pdfs",
    "chag:pardes:aggregate": "node scripts/aggregate-chag-pardes.mjs --all",
    "chag:pardes:export": "node scripts/export-chag-pardes-fallback.mjs",
    "chag:pardes:seed": "node scripts/build-chag-pardes.mjs --all",
    "chag:pardes": "npm run chag:pardes:aggregate && npm run chag:pardes:export && npm run chag:pardes:seed",
    "chag:pardes:deploy": "tsx --env-file=.env.local scripts/deploy-chag-pardes.ts --all",
    "chag:pardes:migrate": "node --env-file=.env.local scripts/apply-chag-pardes-migration.mjs",
    "chag:pardes:prod": "npm run chag:pardes:migrate && npm run chag:pardes:deploy",
    "chag:pardes:check": "tsx --env-file=.env.local scripts/check-chag-pardes-migration.mjs",
    "chag:pardes:sql-all": "node scripts/build-chag-pardes-all-sql.mjs"
  },
  "dependencies": {
    "@hebcal/core": "^5.9.0",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-navigation-menu": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@stripe/stripe-js": "^5.5.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.468.0",
    "mercadopago": "^3.0.0",
    "next": "^16.2.6",
    "next-themes": "^0.4.4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "4.8.69",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-pdf": "^9.2.1",
    "sonner": "^1.7.2",
    "stripe": "^17.7.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "^16.2.6",
    "pg": "^8.21.0",
    "postcss": "^8.5.1",
    "supabase": "^2.98.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3"
  }
}
