# ============================================================
# Brit Mashiach - Variáveis de Ambiente
# Copiar para .env.local e preencher com os valores reais
# NUNCA commitar o arquivo .env.local no git
# ============================================================

# ---- Supabase -----------------------------------------------
# Obtidas em: supabase.com > seu projeto > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Usar apenas em server-side (webhook Stripe, página /admin — promoção de roles)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Opcional: URI Postgres para aplicar migrations via script (Settings → Database → URI)
# SUPABASE_DB_URL=postgresql://postgres.[ref]:[SENHA]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# ---- Mercado Pago -------------------------------------------
# Access Token (produção: APP_USR-..., teste: TEST-...)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxx
# Opcional: secret do webhook (Developers → Webhooks)
# MERCADOPAGO_WEBHOOK_SECRET=xxxxxxxxxxxx

# ---- Asaas (PIX recorrente + anual) -------------------------
# Obtida em: asaas.com → Integrações → API
ASAAS_API_KEY=$aact_xxxxxxxxxxxx
# production (padrão) ou sandbox
ASAAS_ENV=production
# Token do webhook (header asaas-access-token) — Integrações → Webhooks
ASAAS_WEBHOOK_TOKEN=seu_token_secreto
# Webhook URL: https://britimmashiach.com/api/asaas/webhook
# Eventos: Cobranças + Pix Automático
# Pix Automático: solicitar habilitação em integracoes@asaas.com.br

# ---- Stripe (opcional — oculto quando Asaas está ativo) ----
# Obtidas em: stripe.com > Developers > API Keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxx
# Criada em: stripe.com > Developers > Webhooks
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
# ID do preço criado para a assinatura Premium (R$ 47/mês)
STRIPE_PRICE_ID_PREMIUM=price_xxxxxxxxxxxx
# Forçar exibição do Stripe na /premium mesmo com Asaas configurado
# NEXT_PUBLIC_PREMIUM_STRIPE_ENABLED=true

# ---- Aplicação ----------------------------------------------
# Em desenvolvimento: http://localhost:3000
# Em produção (domínio canónico do site — sitemap, canonical, OG, links Stripe/auth):
#   https://britimmashiach.com
# Supabase → Authentication → URL Configuration → Redirect URLs:
#   https://britimmashiach.com/auth/callback
#   https://britimmashiach.com/auth/callback*   (permite ?next=/profile no link do e-mail)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- SEO (Google Search Console) ---------------------------
# Search Console → Configurações → Verificação de propriedade → tag HTML
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=xxxxxxxxxxxxxxxxxxxx

# ---- Notificações ao administrador (CallMeBot) -------------
# Avisa o Rav quando alguém envia um Pedido de Oração ou usa a Ouvidoria,
# e também a cada novo cadastro. Tudo falha em silêncio: nunca quebra o site.
#
# 1) WhatsApp de TEXTO (preferido p/ mensagens dos formulários):
#    - No WhatsApp, adicione +34 644 60 90 95 e envie:
#         I allow callmebot to send me messages
#    - O bot responde com uma APIKEY.
#    - Use o SEU número (com DDI, sem '+') que vai RECEBER os avisos.
# CALLMEBOT_WHATSAPP_PHONE=5516996326446
# CALLMEBOT_WHATSAPP_APIKEY=000000
#
# 2) CHAMADA telefônica (TTS) — usada para novos cadastros e como fallback
#    quando o WhatsApp acima não estiver configurado:
# CALLMEBOT_PHONE=5516996326446
# CALLMEBOT_APIKEY=000000

# ---- Calendário / sedrá ------------------------------------
# Lista opcional: slugs do registro de Parashot (ex.: bereshit,noach) com estudo
# publicado em `/studies/{slug}-pardes`. Seeds em `PLACEHOLDER_STUDIES` já entram
# automaticamente; use isto quando houver apenas no Supabase, sem atualizar seeds.
# NEXT_PUBLIC_PUBLISHED_PARSHA_STUDY_SLUGS=noach,vayera
